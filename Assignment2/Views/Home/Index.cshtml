@model IEnumerable<Assignment2.Models.Student>

@{
    ViewData["Title"] = "Students";
}

<h1>Students</h1>

<h7>Diya Patel</h7>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>Student ID</th>
            <th>Name</th>
            <th>Major</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.StudentId</td>
                <td>@student.Name</td>
                <td>@student.Major</td>
            </tr>
        }
    </tbody>
</table>

<a href="/courses" class="btn btn-primary">
    View Courses
</a>